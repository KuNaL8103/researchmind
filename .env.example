GOOGLE_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ── Vector RAG ───────────────────────────────────────────────────────────────
# gemini (default) uses Google embeddings; huggingface runs fully local.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Optional reduced vector size (e.g. 768) for cheaper/lighter storage:
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_PROVIDER=huggingface
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# diversified (per-URL cap) or mmr; similarity disables diversification
RAG_RETRIEVAL_MODE=diversified
RAG_FETCH_K=20
RAG_MAX_CHUNKS_PER_SOURCE=2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=4

# ── Scraping / API / telemetry ───────────────────────────────────────────────
MAX_SCRAPE_CHARS=20000
SCRAPE_TIMEOUT_SECONDS=10
CORS_ORIGINS=*
LOG_LEVEL=INFO
TELEMETRY_LOG_DIR=logs
